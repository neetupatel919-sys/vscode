<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Modern Website</title>
  <style>
    /* General Styling */
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      margin: 0;
      padding: 0;
      background: linear-gradient(135deg, #89f7fe, #66a6ff);
      color: #333;
      animation: fadeIn 1.2s ease-in;
    }

    @keyframes fadeIn {
      from {opacity: 0;}
      to {opacity: 1;}
    }

    /* Header */
    header {
      background: #222;
      color: white;
      text-align: center;
      padding: 50px 20px;
    }

    header h1 {
      font-size: 2.5em;
      margin: 0;
    }

    header p {
      font-size: 1.2em;
      margin-top: 10px;
    }

    /* Navbar */
    nav {
      background: #444;
      padding: 15px;
      text-align: center;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin: 0 20px;
      font-size: 18px;
      position: relative;
      transition: color 0.3s;
    }

    nav a::after {
      content: "";
      position: absolute;
      width: 0%;
      height: 3px;
      background: #66a6ff;
      left: 0;
      bottom: -5px;
      transition: width 0.3s;
    }

    nav a:hover {
      color: #66a6ff;
    }

    nav a:hover::after {
      width: 100%;
    }

    /* Main Section */
    main {
      padding: 30px;
      max-width: 900px;
      margin: auto;
    }

    .card {
      background: white;
      padding: 20px;
      margin: 20px 0;
      border-radius: 15px;
      box-shadow: 0 6px 12px rgba(0,0,0,0.2);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .card:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 20px rgba(0,0,0,0.3);
    }

    h2 {
      color: #444;
    }

    ul {
      list-style: none;
      padding: 0;
    }

    ul li {
      background: #66a6ff;
      color: white;
      padding: 10px;
      margin: 5px 0;
      border-radius: 8px;
      transition: background 0.3s;
    }

    ul li:hover {
      background: #4a8fe7;
    }

    /* Button */
    .btn {
      display: inline-block;
      padding: 12px 25px;
      margin-top: 15px;
      background: #66a6ff;
      color: white;
      border: none;
      border-radius: 25px;
      font-size: 16px;
      cursor: pointer;
      transition: background 0.3s, transform 0.2s;
      text-decoration: none;
    }

    .btn:hover {
      background: #4a8fe7;
      transform: scale(1.05);
    }

    /* Footer */
    footer {
      text-align: center;
      padding: 20px;
      background: #222;
      color: white;
      margin-top: 30px;
    }
  </style>
</head>
<body>

  <header>
    <h1>✨ My Stylish Website ✨</h1>
    <p>Made with HTML, CSS & Love ❤️</p>
    <a href="#contact" class="btn">Contact Me</a>
  </header>

  <nav>
    <a href="#">Home</a>
    <a href="#about">About</a>
    <a href="#hobbies">Hobbies</a>
    <a href="#contact">Contact</a>
  </nav>

  <main>
    <div class="card" id="about">
      <h2>About Me</h2>
      <p>Hello! My name is Atul. I’m learning web development. This is my modern and stylish website.</p>
    </div>

    <div class="card" id="hobbies">
      <h2>My Hobbies</h2>
      <ul>
        <li>⚽ Sports</li>
        <li>📚 Reading</li>
        <li>💻 Coding</li>
      </ul>
    </div>

    <div class="card" id="contact">
      <h2>Contact</h2>
      <p>Email: <a href="mailto:example@gmail.com">example@gmail.com</a></p>
      <a href="mailto:example@gmail.com" class="btn">Send Email</a>
    </div>
  </main>

  <footer>
    <p>© 2025 My Stylish Website | All Rights Reserved</p>
  </footer>

</body>
</html>
